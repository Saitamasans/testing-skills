{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testing-skills.local/js-test-mapper/run-data.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "run",
    "environment",
    "account_context",
    "role_context",
    "batches",
    "assets",
    "technical_facts",
    "runtime_observations",
    "evidence",
    "degradation",
    "runtime",
    "technical_resource_gets",
    "active_business_api_calls"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run": {
      "type": "object",
      "required": ["run_id", "target_url", "started_at", "finished_at", "status"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "target_url": {"type": "string", "format": "uri", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["completed", "partial", "blocked"]},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "environment": {"type": "string", "minLength": 1},
    "account_context": {"type": "object"},
    "role_context": {"type": "object"},
    "batches": {"type": "array", "items": {"type": "object"}},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "technical_facts": {"type": "array", "items": {"$ref": "#/$defs/technicalFact"}},
    "runtime_observations": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "degradation": {"type": "array", "items": {"type": "object"}},
    "runtime": {
      "type": "object",
      "required": ["runtime_version", "node_version", "minimum_node", "playwright_version"],
      "properties": {
        "runtime_version": {"type": "string", "minLength": 1},
        "node_version": {"type": "string", "minLength": 1},
        "minimum_node": {"const": 20},
        "playwright_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "technical_resource_gets": {"type": "integer", "minimum": 0},
    "active_business_api_calls": {"const": 0},
    "analysis_focus": {"type": "array"},
    "structural_relations": {"type": "array"},
    "call_chain_candidates": {"type": "array"},
    "cognition": {"type": "object"},
    "stage4": {
      "type": "object",
      "required": ["lineage_id", "current_batch", "display_id_registry", "entities", "revisions", "successor_candidates"],
      "properties": {
        "lineage_id": {"type": "string", "minLength": 1},
        "current_batch": {"type": ["string", "null"]},
        "display_id_registry": {"type": "array"},
        "entities": {"type": "object"},
        "revisions": {"type": "array"},
        "successor_candidates": {"type": "array"},
        "batches": {"type": "array"},
        "batch_entities": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["asset_id", "canonical_url", "asset_type", "classification", "discovery_sources", "runtime_loaded", "first_seen_batch", "last_seen_batch"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^asset-[a-f0-9]{16}$"},
        "canonical_url": {"type": "string", "format": "uri", "minLength": 1},
        "asset_type": {"enum": ["js", "worker", "source_map"]},
        "content_sha256": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-f0-9]{64}$"}]},
        "size_bytes": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
        "classification": {"enum": ["first_party", "app_associated", "third_party", "unknown"]},
        "classification_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "discovery_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "runtime_loaded": {"type": "boolean"},
        "http_status": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 100, "maximum": 599}]},
        "response_headers": {"type": "object"},
        "first_seen_batch": {"type": "string", "minLength": 1},
        "last_seen_batch": {"type": "string", "minLength": 1},
        "source_map": {"$ref": "#/$defs/sourceMap"},
        "previous_sha256": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-f0-9]{64}$"}]},
        "content_changed": {"type": "boolean"},
        "unchanged_from_previous_run": {"type": "boolean"},
        "duplicate_of": {"type": "string", "pattern": "^asset-[a-f0-9]{16}$"},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "sourceMap": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["not_declared", "resolved", "invalid", "unavailable", "rejected"]},
        "pointer": {
          "type": "object",
          "required": ["url", "source"],
          "properties": {
            "url": {"type": "string", "format": "uri", "minLength": 1},
            "source": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "sources": {"type": "array", "items": {"type": "string"}},
        "has_sources_content": {"type": "boolean"},
        "source_count": {"type": "integer", "minimum": 0},
        "sample_original_position": {
          "type": "object",
          "properties": {
            "source": {"type": ["string", "null"]},
            "line": {"type": ["integer", "null"]},
            "column": {"type": ["integer", "null"]},
            "name": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "mapping_sample": {"type": "string"},
        "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
        "reason": {"type": "string", "minLength": 1},
        "error": {"type": "string", "minLength": 1},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "technicalFact": {
      "type": "object",
      "required": ["fact_id", "asset_id", "fact_type", "value", "location", "evidence_level", "context"],
      "properties": {
        "fact_id": {"type": "string", "pattern": "^fact-[a-f0-9]{16}$"},
        "asset_id": {"type": "string", "pattern": "^asset-[a-f0-9]{16}$"},
        "fact_type": {"type": "string", "minLength": 1},
        "value": {"type": "string"},
        "location": {
          "type": "object",
          "required": ["file", "line", "column"],
          "properties": {
            "file": {"type": "string", "minLength": 1},
            "line": {"type": "integer", "minimum": 1},
            "column": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "snippet": {"type": "string"},
        "evidence_level": {"enum": ["E1", "E2", "E3", "E4"]},
        "context": {"type": "string", "minLength": 1},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "asset_id", "sha256", "source", "persisted_bytes"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^evidence-asset-[a-f0-9]{16}$"},
        "asset_id": {"type": "string", "pattern": "^asset-[a-f0-9]{16}$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "persisted_bytes": {"const": false},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
